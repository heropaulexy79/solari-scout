{
  "version": 2,
  "builds": [
    {
      "src": "examples/solari-scout/server.ts",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "examples/solari-scout/src/**",
          "examples/solari-scout/public/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "examples/solari-scout/server.ts"
    }
  ],
  "functions": {
    "examples/solari-scout/server.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  }
}
